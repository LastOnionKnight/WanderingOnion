<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Author>LastOnionKnight</Author>
    <Name>Wandering Onion</Name>
    <InternalName>WanderingOnion</InternalName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <MinimumDalamudVersion>15.0.0</MinimumDalamudVersion>
    <Punchline>Intelligent MIDI player, arranger, and auto-converter for FFXIV Bard Performance.</Punchline>
    <Description>Rebuilt from scratch with an automated arrangement engine: converts arbitrary MIDIs into cleanly playable FFXIV tracks for solo or multi-bard ensembles without manual DAW editing.</Description>
    <RepoUrl>https://github.com/LastOnionKnight/WanderingOnion</RepoUrl>
    <Tags>bard;performance;music;midi;converter;arranger;ensemble;wandering-onion</Tags>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
  </ItemGroup>

</Project>
